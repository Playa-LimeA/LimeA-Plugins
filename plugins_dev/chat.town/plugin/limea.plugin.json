{
  "id": "chat.town",
  "name": "陪伴小镇",
  "version": "0.2.4",
  "apiVersion": 13,
  "hostVersion": ">=0.1.1 <1",
  "entry": "backend.mjs",
  "permissions": [
    "character:avatar",
    "character:town-state",
    "character:town-residents",
    "character:town-resident-avatars"
  ],
  "page": {
    "entry": "page.mjs",
    "description": "入住角色各有自己的家，在同一个小镇生活、出门逛街，也能去其他住客家做客。",
    "author": "Playa"
  },
  "tools": [
    {
      "id": "list_residents",
      "name": "列出小镇住客",
      "description": "List the characters currently living in Companion Town. Use to answer who lives here or obtain a resident ID to look up or visit.",
      "access": "read",
      "modes": [
        "chat"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "id": "get_resident_state",
      "name": "查询住客状态",
      "description": "Get a town resident's confirmed location, activity and current phase. Omit resident_id for your own state, or use an ID from the resident list to check another resident.",
      "access": "read",
      "modes": [
        "chat"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "resident_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "additionalProperties": false
      }
    },
    {
      "id": "list_activities",
      "name": "查看小镇地点和活动",
      "description": "List the accessible town locations and supported activities. Optionally filter by scene. Use these IDs to arrange a visit or an activity.",
      "access": "read",
      "modes": [
        "chat"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "scene": {
            "type": "string",
            "enum": [
              "home",
              "street_corner",
              "cafe",
              "park",
              "bakery",
              "shop",
              "supermarket"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    {
      "id": "go_to",
      "name": "前往小镇地点",
      "description": "Arrange for yourself to walk to a verified location in town. Home means your own home. Use when you have decided to go somewhere, not when someone only asks where you are. A return value of accepted means the trip has been arranged, not that you have arrived.",
      "access": "local",
      "modes": [
        "chat"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "location": {
            "type": "string",
            "enum": [
              "home",
              "street_corner",
              "cafe",
              "park",
              "bakery",
              "shop",
              "supermarket"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "location"
        ]
      }
    },
    {
      "id": "visit_resident",
      "name": "去住客家做客",
      "description": "Arrange for yourself to visit another resident at their home. Use a resident ID from list_residents. A visit can be arranged when the host is home. A return value of accepted means the trip has been arranged; confirm arrival using your current town state.",
      "access": "local",
      "modes": [
        "chat"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "resident_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "additionalProperties": false,
        "required": [
          "resident_id"
        ]
      }
    },
    {
      "id": "do_activity",
      "name": "安排小镇活动",
      "description": "Arrange for yourself to walk to an activity point and start a verified town activity after arrival. Choose an activity ID from the available catalog. An accepted plan is not an activity already in progress.",
      "access": "local",
      "modes": [
        "chat"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "activity": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          }
        },
        "additionalProperties": false,
        "required": [
          "activity"
        ]
      }
    }
  ],
  "panels": [
    {
      "id": "chat.town.map",
      "name": "陪伴小镇",
      "entry": "panel.mjs",
      "placement": "tab",
      "modes": ["chat"]
    }
  ],
  "resources": [
    "town.css",
    "locations.mjs",
    "routes.mjs",
    "routine.mjs",
    "journey.mjs",
    "town-clock.mjs",
    "navigation.mjs",
    "town-state.mjs",
    "town-tools.mjs",
    "town-map.mjs",
    "town-status-card.mjs",
    "viewer.mjs",
    "visitor.mjs",
    "vendor/three-town.mjs",
    "assets/town-map.svg",
    "assets/home.glb",
    "assets/street_corner.glb",
    "assets/cafe.glb",
    "assets/park.glb",
    "assets/bakery.glb",
    "assets/shop.glb",
    "assets/supermarket.glb"
  ]
}
