{
  "id": "games.gomoku",
  "name": "五子棋",
  "version": "0.3.2",
  "apiVersion": 12,
  "hostVersion": ">=0.1.0 <1.0.0",
  "entry": "backend.mjs",
  "permissions": [
    "fs:plugin-data"
  ],
  "resources": [
    "assets/stone.mp3"
  ],
  "page": {
    "entry": "page.mjs",
    "description": "和当前角色下一盘五子棋。15×15 自由规则，开局随机分配黑白，黑棋先行；双方轮流落子，横、竖或斜向连续五子或以上获胜。可以选择模型独立思考或本地引擎给出候选，对局记录、暂停恢复和再来一局都随聊天打开，不设积分压力。",
    "author": "Playa",
    "illustration": "assets/banner.webp"
  },
  "panels": [
    {
      "id": "games.gomoku.play",
      "name": "五子棋",
      "placement": "miniGame",
      "modes": [
        "chat"
      ],
      "entry": "panel.mjs",
      "icon": "assets/icon.png"
    }
  ],
  "tools": [
    {
      "id": "history",
      "name": "五子棋对局记录",
      "description": "查询当前聊天最近五局五子棋的完整落子顺序、双方颜色、结果和比分。用户在结束游戏后谈起此前下过的棋、询问胜负或复盘时，使用此工具读取存档，不要声称未下过或凭空猜测。只查询记录，不会重新开局。更早的对局可能不在本次返回范围。",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "modes": [
        "chat"
      ],
      "access": "local"
    },
    {
      "id": "start",
      "name": "五子棋陪玩",
      "description": "开始或继续与用户下五子棋。15×15自由规则，随机分配黑白，黑棋先行，连续5子或以上获胜。本工具在用户回合等待；本局结束后用一句话宣布结果，再调用它等待或执行用户在界面选择的再来一局或下次再玩。不要替用户决定。",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "modes": [
        "chat"
      ],
      "panelId": "games.gomoku.play",
      "access": "local"
    },
    {
      "id": "place_stone",
      "name": "五子棋落子",
      "description": "只在五子棋模型回合使用。根据当前完整棋盘选择一个空点；列A到O从左到右，行1到15从上到下，roundId和revision须使用最新值。落子后自动等待用户回合。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "roundId": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "row": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15
          },
          "column": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "E",
              "F",
              "G",
              "H",
              "I",
              "J",
              "K",
              "L",
              "M",
              "N",
              "O"
            ]
          }
        },
        "required": [
          "roundId",
          "revision",
          "row",
          "column"
        ],
        "additionalProperties": false
      },
      "modes": [
        "chat"
      ],
      "panelId": "games.gomoku.play",
      "access": "local"
    }
  ]
}
