{
  "id": "team.office",
  "name": "团队办公室",
  "version": "0.5.1",
  "apiVersion": 15,
  "hostVersion": ">=0.1.0 <1",
  "entry": "backend.mjs",
  "permissions": ["profile:avatar", "fs:selected-media", "fs:plugin-data"],
  "page": {
    "entry": "page.mjs",
    "description": "把团队工作区变成一栋可浏览的三维办公室。切换楼层，查看团队成员的工作状态，以及他们现在所在的区域。",
    "author": "Playa",
    "illustration": "assets/office-cover.png"
  },
  "panels": [
    {
      "id": "team.office.floor",
      "name": "办公室",
      "entry": "panel.mjs",
      "placement": "teamOffice",
      "modes": ["group"]
    }
  ],
  "resources": [
    "assets/icon.png",
    "page.css",
    "screen-settings.mjs",
    "screen-video.mjs",
    "office.css",
    "activity.mjs",
    "floor-picker.mjs",
    "floors.mjs",
    "office-routes.mjs",
    "orbit.mjs",
    "vendor/three-office.mjs",
    "assets/standard-floor.glb",
    "assets/standard-scene.json",
    "assets/standard-floor.webp",
    "assets/standard-seats.json",
    "assets/lobby.glb",
    "assets/lobby-scene.json",
    "assets/lobby.webp",
    "assets/executive.glb",
    "assets/executive-scene.json",
    "assets/executive.webp"
  ]
}
