{
  "id": "connectors.baidu-netdisk",
  "name": "百度网盘",
  "version": "1.0.0",
  "apiVersion": 10,
  "hostVersion": ">=0.1.0",
  "entry": "backend.mjs",
  "toolPresentation": {
    "name": "百度网盘",
    "icon": "assets/icon.png"
  },
  "connections": [
    {
      "provider": "baidu-netdisk",
      "permissionSet": "baidu-netdisk-read-write"
    }
  ],
  "tools": [
    {
      "id": "get_quota",
      "name": "查看网盘容量",
      "description": "查询当前授权百度网盘账号的总空间、已用空间及剩余空间配额。",
      "modes": ["work", "chat"],
      "access": "read",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "checkfree": { "type": "boolean" },
          "checkexpire": { "type": "boolean" }
        },
        "required": []
      }
    },
    {
      "id": "list_files",
      "name": "浏览目录文件",
      "description": "列出百度网盘指定目录下的文件与子文件夹。个人应用默认访问 /apps/<应用名>/ 专属目录。",
      "modes": ["work", "chat"],
      "access": "read",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dir": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "order": { "type": "string", "enum": ["name", "time", "size"] },
          "desc": { "type": "boolean" },
          "start": { "type": "integer", "minimum": 0, "maximum": 100000 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
          "folderOnly": { "type": "boolean" }
        },
        "required": []
      }
    },
    {
      "id": "search_files",
      "name": "搜索网盘文件",
      "description": "在指定目录内按关键字搜索百度网盘文件，支持递归子目录与分页。",
      "modes": ["work", "chat"],
      "access": "read",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "minLength": 1, "maxLength": 200 },
          "dir": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "page": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "num": { "type": "integer", "minimum": 1, "maximum": 100 },
          "recursion": { "type": "boolean" }
        },
        "required": ["key"]
      }
    },
    {
      "id": "get_file_metas",
      "name": "查看文件元数据",
      "description": "按 1 到 50 个 fs_id（支持数字或整数字符串）批量查询百度网盘文件的大小、路径、修改时间等元数据，不返回直链下载链接。",
      "modes": ["work", "chat"],
      "access": "read",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fsids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "oneOf": [
                { "type": "integer", "minimum": 1 },
                { "type": "string", "pattern": "^[1-9][0-9]{0,18}$" }
              ]
            }
          },
          "thumb": { "type": "boolean" },
          "extra": { "type": "boolean" }
        },
        "required": ["fsids"]
      }
    },
    {
      "id": "create_folder",
      "name": "新建文件夹",
      "description": "在百度网盘授权目录中新建文件夹（非破坏性，rtype 0=冲突按策略处理，1=路径冲突自动重命名）。",
      "modes": ["work", "chat"],
      "access": "write",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 2, "maxLength": 1024 },
          "rtype": { "type": "integer", "enum": [0, 1] }
        },
        "required": ["path"]
      }
    },
    {
      "id": "rename_file",
      "name": "重命名文件",
      "description": "重命名 1 到 20 个百度网盘文件或文件夹。newname 仅为新文件名，不含路径分隔符。",
      "modes": ["work", "chat"],
      "access": "write",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": { "type": "string", "minLength": 2, "maxLength": 1024 },
                "newname": { "type": "string", "minLength": 1, "maxLength": 255 }
              },
              "required": ["path", "newname"]
            }
          }
        },
        "required": ["items"]
      }
    },
    {
      "id": "move_files",
      "name": "移动文件",
      "description": "将 1 到 20 个百度网盘文件或文件夹移动到目标目录，支持可选新名称与冲突策略 ondup。",
      "modes": ["work", "chat"],
      "access": "write",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": { "type": "string", "minLength": 2, "maxLength": 1024 },
                "dest": { "type": "string", "minLength": 2, "maxLength": 1024 },
                "newname": { "type": "string", "minLength": 1, "maxLength": 255 }
              },
              "required": ["path", "dest"]
            }
          },
          "ondup": { "type": "string", "enum": ["fail", "newcopy", "overwrite", "skip"] }
        },
        "required": ["items"]
      }
    },
    {
      "id": "copy_files",
      "name": "复制文件",
      "description": "将 1 到 20 个百度网盘文件或文件夹复制到目标目录，支持可选新名称与冲突策略 ondup。",
      "modes": ["work", "chat"],
      "access": "write",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": { "type": "string", "minLength": 2, "maxLength": 1024 },
                "dest": { "type": "string", "minLength": 2, "maxLength": 1024 },
                "newname": { "type": "string", "minLength": 1, "maxLength": 255 }
              },
              "required": ["path", "dest"]
            }
          },
          "ondup": { "type": "string", "enum": ["fail", "newcopy", "overwrite", "skip"] }
        },
        "required": ["items"]
      }
    },
    {
      "id": "delete_files",
      "name": "删除文件",
      "description": "删除 1 到 20 个百度网盘文件或文件夹（不可删除根目录、/apps 或 /apps/<应用名> 顶层目录）。",
      "modes": ["work", "chat"],
      "access": "write",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": { "type": "string", "minLength": 2, "maxLength": 1024 }
          }
        },
        "required": ["paths"]
      }
    }
  ],
  "skills": ["skills/baidu-netdisk/SKILL.md"],
  "page": {
    "entry": "page.mjs",
    "author": "Playa",
    "illustration": "assets/banner.png",
    "description": "连接百度网盘账号，在 LimeA 中浏览与搜索授权目录（个人应用默认位于 /apps/<应用名>/）、查看容量与文件元数据，并按当前会话权限新建文件夹、重命名、移动、复制或删除文件。"
  },
  "resources": ["assets/icon.png", "assets/banner.png"]
}
