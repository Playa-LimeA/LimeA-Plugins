{
  "id": "connectors.notion",
  "name": "Notion",
  "version": "2.1.2",
  "apiVersion": 10,
  "hostVersion": ">=0.1.0",
  "entry": "backend.mjs",
  "toolPresentation": {
    "name": "Notion",
    "icon": "assets/icon.png"
  },
  "connections": [
    {
      "provider": "notion",
      "permissionSet": "notion-read-write"
    }
  ],
  "tools": [
    {
      "id": "search",
      "name": "搜索页面",
      "description": "搜索用户授权给 LimeA 的 Notion 页面标题。不会搜索页面正文。结果只覆盖已共享页面；空结果不代表工作区无内容。nextCursor 可用于下一页。 返回 connection-result-too-large 时，使用更小的 pageSize（最小 1）和同一 cursor 重试。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 256
          },
          "cursor": {
            "type": "string",
            "maxLength": 256
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": []
      },
      "modes": [
        "work",
        "chat"
      ],
      "access": "read"
    },
    {
      "id": "page",
      "name": "读取页面信息",
      "description": "读取一个已授权页面的标题与受支持属性。pageId 使用搜索结果里的页面 ID；正文用 children 读取。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pageId": {
            "type": "string"
          }
        },
        "required": [
          "pageId"
        ]
      },
      "modes": [
        "work",
        "chat"
      ],
      "access": "read"
    },
    {
      "id": "children",
      "name": "读取页面内容",
      "description": "分页读取页面或块的直接子块（每页最多 50 个），以文本形式返回。hasChildren 的块需要用其 id 再调用本工具；不下载附件、不自动访问外链。nextCursor 可用于下一页。 返回 connection-result-too-large 时，使用更小的 pageSize（最小 1）和同一 cursor 重试。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "blockId": {
            "type": "string"
          },
          "cursor": {
            "type": "string",
            "maxLength": 256
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "blockId"
        ]
      },
      "modes": [
        "work",
        "chat"
      ],
      "access": "read"
    },
    {
      "id": "search_sources",
      "name": "搜索数据源",
      "description": "按标题搜索已共享的数据源；支持分页。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 256
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": []
      },
      "modes": [
        "work",
        "chat"
      ],
      "access": "read"
    },
    {
      "id": "database",
      "name": "读取数据库",
      "description": "读取数据库与其数据源列表。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "databaseId": {
            "type": "string",
            "minLength": 32,
            "maxLength": 36
          }
        },
        "required": [
          "databaseId"
        ]
      },
      "modes": [
        "work",
        "chat"
      ],
      "access": "read"
    },
    {
      "id": "source",
      "name": "读取数据源",
      "description": "读取数据源属性名称、标识与类型。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 32,
            "maxLength": 36
          }
        },
        "required": [
          "sourceId"
        ]
      },
      "modes": [
        "work",
        "chat"
      ],
      "access": "read"
    },
    {
      "id": "query_source",
      "name": "查询数据源",
      "description": "查询数据源记录；支持官方过滤条件、排序与分页。requestStatus 不完整时结果不是完整集合。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 32,
            "maxLength": 36
          },
          "filter": {
            "type": "object",
            "additionalProperties": true
          },
          "sorts": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [
          "sourceId"
        ]
      },
      "modes": [
        "work",
        "chat"
      ],
      "access": "read"
    },
    {
      "id": "comments",
      "name": "读取评论",
      "description": "读取共享页面或内容块上的评论；支持分页。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "blockId": {
            "type": "string",
            "minLength": 32,
            "maxLength": 36
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [
          "blockId"
        ]
      },
      "modes": [
        "work",
        "chat"
      ],
      "access": "read"
    },
    {
      "id": "request_write",
      "name": "管理工作区内容",
      "description": "按 operation 执行 Notion 操作，插件自动选择正确接口。优先用 create_page、append_blocks、update_page、create_comment 常用工具。先加载技能 connectors.notion:notion-workspace 及相关参考资料。含目标的操作必填 targetId；delete_view、delete_comment、trash_block 不带 body，其余必填 body。权限跟随宿主设置，结果不明先核对，不重复写入。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "create_page",
              "update_page",
              "move_page",
              "update_markdown",
              "append_blocks",
              "update_block",
              "trash_block",
              "create_database",
              "update_database",
              "create_data_source",
              "update_data_source",
              "create_view",
              "update_view",
              "delete_view",
              "create_comment",
              "update_comment",
              "delete_comment"
            ]
          },
          "targetId": {
            "type": "string",
            "pattern": "^(?:[a-fA-F0-9]{32}|[a-fA-F0-9]{8}(?:-[a-fA-F0-9]{4}){3}-[a-fA-F0-9]{12})$"
          },
          "body": {
            "type": "object",
            "description": "符合当前操作的 Notion 参数对象，具体示例见插件技能对应参考资料。"
          }
        },
        "required": [
          "operation"
        ]
      },
      "modes": [
        "work",
        "chat"
      ],
      "access": "write"
    },
    {
      "id": "create_page",
      "name": "创建页面",
      "description": "在已共享父页面或数据源下创建页面。body 必须有 parent 和 properties。 先加载技能 connectors.notion:notion-workspace，按需读取参考资料；无需提供请求方法或路径。权限跟随宿主设置。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "body": {
            "type": "object",
            "description": "符合当前操作的 Notion 参数对象，具体示例见插件技能对应参考资料。"
          }
        },
        "required": [
          "body"
        ]
      },
      "modes": [
        "work",
        "chat"
      ],
      "access": "write"
    },
    {
      "id": "append_blocks",
      "name": "追加内容",
      "description": "向页面或块追加子块。blockId 取已读取的目标 ID，children 是 Notion 块对象数组。 先加载技能 connectors.notion:notion-workspace，按需读取参考资料；无需提供请求方法或路径。权限跟随宿主设置。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "blockId": {
            "type": "string",
            "pattern": "^(?:[a-fA-F0-9]{32}|[a-fA-F0-9]{8}(?:-[a-fA-F0-9]{4}){3}-[a-fA-F0-9]{12})$"
          },
          "children": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "blockId",
          "children"
        ]
      },
      "modes": [
        "work",
        "chat"
      ],
      "access": "write"
    },
    {
      "id": "update_page",
      "name": "修改页面",
      "description": "更新页面属性、图标、封面或回收站状态；body 只包含要修改的字段。 先加载技能 connectors.notion:notion-workspace，按需读取参考资料；无需提供请求方法或路径。权限跟随宿主设置。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pageId": {
            "type": "string",
            "pattern": "^(?:[a-fA-F0-9]{32}|[a-fA-F0-9]{8}(?:-[a-fA-F0-9]{4}){3}-[a-fA-F0-9]{12})$"
          },
          "body": {
            "type": "object",
            "description": "符合当前操作的 Notion 参数对象，具体示例见插件技能对应参考资料。"
          }
        },
        "required": [
          "pageId",
          "body"
        ]
      },
      "modes": [
        "work",
        "chat"
      ],
      "access": "write"
    },
    {
      "id": "create_comment",
      "name": "发表评论",
      "description": "创建评论或回复讨论。body 包含 parent 或 discussion_id，以及 rich_text 数组。 先加载技能 connectors.notion:notion-workspace，按需读取参考资料；无需提供请求方法或路径。权限跟随宿主设置。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "body": {
            "type": "object",
            "description": "符合当前操作的 Notion 参数对象，具体示例见插件技能对应参考资料。"
          }
        },
        "required": [
          "body"
        ]
      },
      "modes": [
        "work",
        "chat"
      ],
      "access": "write"
    },
    {
      "id": "read_resource",
      "name": "读取视图、成员或页面属性",
      "description": "读取 Notion 中已授权的对象：kind 为 block（需 id）、page_property（页面 id、propertyId，可分页）、user（用户 id）、current_user、users（可分页）、comment（评论 id）、view（视图 id）、views（databaseId 或 sourceId 二选一，可分页）、templates（数据源 id，可分页及 name 过滤）、markdown（页面 id）。页面属性 ID 解码后不能含斜线、反斜线、控制字符、%、? 或 #。结果有 incomplete 时查看 issues，不可将其视为完整数据。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "block",
              "page_property",
              "user",
              "current_user",
              "users",
              "comment",
              "view",
              "views",
              "templates",
              "markdown"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 32,
            "maxLength": 36
          },
          "propertyId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "databaseId": {
            "type": "string",
            "minLength": 32,
            "maxLength": 36
          },
          "sourceId": {
            "type": "string",
            "minLength": 32,
            "maxLength": 36
          },
          "name": {
            "type": "string",
            "maxLength": 256
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [
          "kind"
        ]
      },
      "modes": [
        "work",
        "chat"
      ],
      "access": "read"
    }
  ],
  "page": {
    "entry": "page.mjs",
    "description": "把 Notion 和你的智能助手连接起来，让它和团队、其他助手共用一套上下文。连接后可以检索工作区、新建和更新页面、管理项目与任务，并把成果存回 Notion。",
    "author": "Playa",
    "illustration": "assets/banner.png"
  },
  "resources": [
    "assets/icon.png"
  ],
  "skills": [
    "skills/notion-workspace/SKILL.md"
  ]
}
